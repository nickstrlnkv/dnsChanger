<Window x:Class="DnsChanger.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DNS Changer — Быстрая смена DNS (IPv4, IPv6, DoH, DoT)"
        Height="760" Width="1020"
        MinHeight="680" MinWidth="920"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgDark}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        
        <!-- Badge Styles -->
        <Style x:Key="FeatureBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- Top Header & Admin bar -->
            <RowDefinition Height="Auto"/>
            <!-- Network Adapter Selector -->
            <RowDefinition Height="Auto"/>
            <!-- Main Content (Presets + Details) -->
            <RowDefinition Height="*"/>
            <!-- Action Bar (Apply / Reset / Cache) -->
            <RowDefinition Height="Auto"/>
            <!-- Bottom Status Toast -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. HEADER & ADMIN STATUS -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- App Title & Subtitle -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="#2563EB" CornerRadius="8" Width="38" Height="38" Margin="0,0,12,0">
                    <TextBlock Text="⚡" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="DNS Changer" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                    <TextBlock Text="Быстрое переключение DNS-серверов, IPv6 и шифрования DoH / DoT" 
                               FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                </StackPanel>
            </StackPanel>

            <!-- Admin Badge & Controls -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Admin Status Chip -->
                <Border x:Name="AdminBadgeBorder" CornerRadius="6" Padding="10,6" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="AdminBadgeText" Text="🛡️ Права администратора" FontSize="12" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>

                <!-- Restart Elevated Button (shown if not admin) -->
                <Button x:Name="BtnElevate" Style="{StaticResource OutlineButton}" 
                        Content="🛡️ Перезапуск от Администратора"
                        Click="RestartElevated_Click" Margin="0,0,10,0" Visibility="Collapsed"/>

                <!-- Open JSON button -->
                <Button Style="{StaticResource OutlineButton}" Content="📂 presets.json" 
                        ToolTip="Открыть файл конфигурации пресетов в блокноте"
                        Click="OpenPresetsJson_Click" Margin="0,0,10,0"/>

                <!-- Flush DNS button -->
                <Button Style="{StaticResource OutlineButton}" Content="🧹 Очистить кэш" 
                        ToolTip="Выполнить сброс кэша DNS (ipconfig /flushdns)"
                        Click="FlushDns_Click"/>
            </StackPanel>
        </Grid>

        <!-- 2. NETWORK ADAPTER CARD -->
        <Border Grid.Row="1" Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" 
                BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="🌐 Сетевой адаптер:" 
                           FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" Margin="0,0,12,6"/>

                <ComboBox Grid.Row="0" Grid.Column="1" x:Name="CmbAdapters"
                          DisplayMemberPath="DisplayName"
                          SelectionChanged="CmbAdapters_SelectionChanged"
                          Margin="0,0,12,6" Height="34"/>

                <Button Grid.Row="0" Grid.Column="2" Style="{StaticResource OutlineButton}" 
                        Content="🔄 Обновить" Click="RefreshAdapters_Click" Height="34" Margin="0,0,0,6"/>

                <!-- Active Adapter Status line -->
                <Border Grid.Row="1" Grid.ColumnSpan="3" Background="{StaticResource InputBg}" 
                        CornerRadius="6" Padding="12,8" Margin="0,6,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Текущий DNS на адаптере:" Foreground="{StaticResource TextSecondary}" 
                                   FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Grid.Column="1" x:Name="TxtCurrentDns" Text="Загрузка..." 
                                   Foreground="#38BDF8" FontWeight="SemiBold" FontSize="13" 
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- 3. MAIN SPLIT AREA (PRESETS LIST + EDITOR) -->
        <Grid Grid.Row="2" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <!-- Left: Presets List -->
                <ColumnDefinition Width="380"/>
                <!-- Divider -->
                <ColumnDefinition Width="16"/>
                <!-- Right: Details & Editor -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: PRESETS LIST -->
            <Border Grid.Column="0" Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" 
                    BorderThickness="1" CornerRadius="8" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header & Add button -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="Пресеты DNS" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                        <Button Style="{StaticResource OutlineButton}" Content="➕ Добавить" 
                                HorizontalAlignment="Right" Padding="10,4" FontSize="12"
                                Click="AddNewPreset_Click"/>
                    </Grid>

                    <!-- Search Box -->
                    <TextBox Grid.Row="1" x:Name="TxtSearch" TextChanged="TxtSearch_TextChanged" 
                             Margin="0,0,0,10" Tag="Поиск пресета..."/>

                    <!-- Presets ListBox -->
                    <ListBox Grid.Row="2" x:Name="LstPresets" 
                             Background="Transparent" BorderThickness="0"
                             SelectionChanged="LstPresets_SelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Margin" Value="0,0,0,6"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="itemBorder" Background="{StaticResource CardBgHover}" 
                                                    BorderBrush="{StaticResource CardBorder}" BorderThickness="1" 
                                                    CornerRadius="6" Padding="10">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="itemBorder" Property="Background" Value="#2D2D38"/>
                                                    <Setter TargetName="itemBorder" Property="BorderBrush" Value="#4B4B5A"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="itemBorder" Property="Background" Value="#1E293B"/>
                                                    <Setter TargetName="itemBorder" Property="BorderBrush" Value="{StaticResource AccentBlue}"/>
                                                    <Setter TargetName="itemBorder" Property="BorderThickness" Value="2"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Top Row: Name + Delete button -->
                                    <Grid Grid.Row="0">
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13" 
                                                   Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis"
                                                   Margin="0,0,24,0"/>
                                        <Button Content="✕" ToolTip="Удалить пресет" HorizontalAlignment="Right"
                                                Foreground="{StaticResource TextMuted}" Background="Transparent"
                                                BorderThickness="0" Cursor="Hand" FontWeight="Bold" FontSize="12"
                                                Tag="{Binding}" Click="DeletePreset_Click"/>
                                    </Grid>

                                    <!-- Description -->
                                    <TextBlock Grid.Row="1" Text="{Binding Description}" FontSize="11" 
                                               Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" 
                                               Margin="0,4,0,6" MaxHeight="32" TextTrimming="CharacterEllipsis"/>

                                    <!-- Bottom Row: Badges & Ping -->
                                    <DockPanel Grid.Row="2">
                                        <!-- Feature Badges -->
                                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                            <!-- IPv4 Badge -->
                                            <Border Style="{StaticResource FeatureBadge}" Background="#1E3A8A"
                                                    Visibility="{Binding HasIPv4, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="IPv4" FontSize="10" Foreground="#93C5FD" FontWeight="Bold"/>
                                            </Border>
                                            <!-- IPv6 Badge -->
                                            <Border Style="{StaticResource FeatureBadge}" Background="#4C1D95"
                                                    Visibility="{Binding HasIPv6, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="IPv6" FontSize="10" Foreground="#C4B5FD" FontWeight="Bold"/>
                                            </Border>
                                            <!-- DoH Badge -->
                                            <Border Style="{StaticResource FeatureBadge}" Background="#064E3B"
                                                    Visibility="{Binding HasDoH, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="DoH" FontSize="10" Foreground="#6EE7B7" FontWeight="Bold"/>
                                            </Border>
                                            <!-- DoT Badge -->
                                            <Border Style="{StaticResource FeatureBadge}" Background="#78350F"
                                                    Visibility="{Binding HasDoT, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="DoT" FontSize="10" Foreground="#FCD34D" FontWeight="Bold"/>
                                            </Border>
                                        </StackPanel>

                                        <!-- Ping result badge (if measured) -->
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding PingDisplay}" FontSize="11" 
                                                   FontWeight="SemiBold" Foreground="#38BDF8" HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"/>
                                    </DockPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Ping All Button -->
                    <Button Grid.Row="3" Style="{StaticResource OutlineButton}" 
                            Content="⚡ Проверить пинг всех серверов" 
                            Click="PingAllPresets_Click" Margin="0,10,0,0"/>
                </Grid>
            </Border>

            <!-- RIGHT: DETAILS & CONFIGURATION EDITOR -->
            <Border Grid.Column="2" Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" 
                    BorderThickness="1" CornerRadius="8" Padding="18">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <!-- Title & Ping Button -->
                        <Grid Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Параметры выбранного пресета" FontSize="16" FontWeight="Bold"/>
                                <TextBlock Text="Вы можете изменить любые адреса перед применением" 
                                           FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                            </StackPanel>

                            <!-- Single Ping button -->
                            <Button Style="{StaticResource OutlineButton}" HorizontalAlignment="Right"
                                    VerticalAlignment="Center" Content="⚡ Измерить пинг"
                                    Click="PingCurrentPreset_Click"/>
                        </Grid>

                        <!-- Preset Name & Description -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Название:" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}"/>
                            <TextBox Grid.Column="1" x:Name="TxtName"/>
                        </Grid>

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Описание:" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}"/>
                            <TextBox Grid.Column="1" x:Name="TxtDescription"/>
                        </Grid>

                        <Separator Background="{StaticResource CardBorder}" Margin="0,0,0,14"/>

                        <!-- SECTION: IPv4 -->
                        <TextBlock Text="🔷 IPv4 Адреса" FontWeight="Bold" FontSize="14" Foreground="#93C5FD" Margin="0,0,0,10"/>
                        
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Основной (Primary):" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}"/>
                            <TextBox Grid.Column="1" x:Name="TxtIPv4Primary"/>
                        </Grid>

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Дополнительный:" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}"/>
                            <TextBox Grid.Column="1" x:Name="TxtIPv4Secondary"/>
                        </Grid>

                        <Separator Background="{StaticResource CardBorder}" Margin="0,0,0,14"/>

                        <!-- SECTION: IPv6 -->
                        <TextBlock Text="🟣 IPv6 Адреса" FontWeight="Bold" FontSize="14" Foreground="#C4B5FD" Margin="0,0,0,10"/>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Основной (Primary):" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}"/>
                            <TextBox Grid.Column="1" x:Name="TxtIPv6Primary"/>
                        </Grid>

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Дополнительный:" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}"/>
                            <TextBox Grid.Column="1" x:Name="TxtIPv6Secondary"/>
                        </Grid>

                        <Separator Background="{StaticResource CardBorder}" Margin="0,0,0,14"/>

                        <!-- SECTION: ENCRYPTION (DoH & DoT) -->
                        <TextBlock Text="🔒 Шифрование DNS (DoH &amp; DoT в Windows 11)" FontWeight="Bold" FontSize="14" Foreground="#6EE7B7" Margin="0,0,0,10"/>

                        <!-- DoH Template -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="DoH Template URL:" Foreground="{StaticResource TextSecondary}"/>
                                <TextBlock Text="(HTTPS шаблон)" FontSize="10" Foreground="{StaticResource TextMuted}"/>
                            </StackPanel>
                            <TextBox Grid.Column="1" x:Name="TxtDoHTemplate" ToolTip="Например: https://cloudflare-dns.com/dns-query"/>
                        </Grid>

                        <!-- DoT Host -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="DoT Host:Port:" Foreground="{StaticResource TextSecondary}"/>
                                <TextBlock Text="(TLS хост)" FontSize="10" Foreground="{StaticResource TextMuted}"/>
                            </StackPanel>
                            <TextBox Grid.Column="1" x:Name="TxtDoTHost" ToolTip="Например: one.one.one.one:853"/>
                        </Grid>

                        <!-- Save & Clone Buttons for Preset -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                            <Button Style="{StaticResource OutlineButton}" Content="💾 Сохранить изменения" 
                                    Click="SavePresetChanges_Click" Margin="0,0,10,0"/>
                            <Button Style="{StaticResource OutlineButton}" Content="📑 Дублировать как новый" 
                                    Click="DuplicatePreset_Click"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- 4. ACTION BAR (APPLY & RESET) -->
        <Border Grid.Row="3" Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" 
                BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Apply DNS Button -->
                <Button Grid.Column="0" Style="{StaticResource AccentButton}" 
                        Content="🚀 Применить выбранный DNS" 
                        Click="ApplyDns_Click" Margin="0,0,14,0"/>

                <!-- Reset to DHCP Button -->
                <Button Grid.Column="1" Style="{StaticResource OutlineButton}" 
                        Content="🔄 Сбросить на DHCP (Автоматически)" 
                        Click="ResetDhcp_Click" Margin="0,0,14,0"/>

                <!-- Busy spinner or note -->
                <TextBlock Grid.Column="2" x:Name="TxtActionNotice" 
                           Text="Нажмите «Применить» для настройки активного сетевого подключения" 
                           Foreground="{StaticResource TextSecondary}" FontSize="12" 
                           VerticalAlignment="Center" HorizontalAlignment="Right"/>
            </Grid>
        </Border>

        <!-- 5. STATUS LOG BAR -->
        <Border Grid.Row="4" x:Name="StatusCard" Background="{StaticResource CardBg}" 
                BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="6" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtStatusIcon" Text="ℹ️" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" x:Name="TxtStatusMessage" Text="Готово к работе" 
                           Foreground="{StaticResource TextPrimary}" FontSize="12" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
